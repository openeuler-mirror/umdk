{
  "global": {
    "host": "127.0.0.1",
    "port": "8888",
    "logPath": "/var/log/aigw",
    "logLevel": "info",
    "snapshotUpdateInterval": 3,
    "securitySchema": "default",
    "cryptoSock": "",
    "reqTimeout": 600
  },
  "zookeeper": {
    "address": "",
    "aclScheme": "default",
    "connectTimeout": 0,
    "sessionTimeout": 0,
    "inferenceInstancePath": "/mep/aigw/instances",
    "scheduleServicePath": "/mep/aigw/global_schedulers"
  },
  "predictor": {
    "predictType": "none",
    "lightgbm": {
      "classifierFile": "",
      "vectorizerFile": ""
    }
  },
  "dataSync": {
    "address": "",
    "path": "/models",
    "interval": 5
  },
  "tokenizers": [
    {
      "tokenizeModelName": "DeepSeek-R1",
      "configPath": "../../test/tokenizer/DeepSeek-R1-Distill-Qwen-7B/tokenizer.json",
      "tokenizerType": "huggingfaceTokenizers"
    }
  ],
  "globalSchedulers": [
    {
      "model": "DeepSeek-R1-Distill-Qwen-7B",
      "blockSize": 128,
      "deployPolicy": "mixed",
      "maxTimeToFirstToken": 200,
      "maxTimeBetweenTokens": 50,
      "tokenizeModelName": "DeepSeek-R1",
      "loadBalancer": {
        "mixed": "roundRobin",
        "prefill": "",
        "decode": "",
        "batchSize": 32,
        "reservedBlockNumber": 50,
        "minMatchedLength": 200
      }
    },
    {
      "model": "DeepSeek-R1",
      "blockSize": 128,
      "deployPolicy": "separated",
      "maxTimeToFirstToken": 200,
      "maxTimeBetweenTokens": 50,
      "tokenizeModelName": "DeepSeek-R1",
      "loadBalancer": {
        "mixed": "",
        "prefill": "roundRobin",
        "decode": "roundRobin",
        "batchSize": 32,
        "reservedBlockNumber": 50,
        "minMatchedLength": 200
      }
    }
  ],
  "limits": {
    "totalInsNum": 2048,
    "insNumPerModel": 128,
    "modelNum": 128,
    "concurrency": 128,
    "maxPromptRunes": 131072
  }
