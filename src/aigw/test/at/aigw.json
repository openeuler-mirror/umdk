{
  "global": {
    "host": "127.0.0.1",
    "port": "8888",
    "logPath": "/var/log/aigw",
    "logLevel": "debug",
    "securitySchema": "default",
    "cryptoSock": "",
    "snapshotUpdateInterval": 1,
    "reqTimeout": 600
  },
  "zookeeper": {
    "address": "",
    "aclScheme": "default",
    "connectTimeout": 0,
    "sessionTimeout": 0,

    "inferenceInstancePath": "/mep/aigw/instances",
    "scheduleServicePath":"/mep/aigw/global_schedulers",
    "enableTls": false,
    "tlsCaFile": "",
    "tlsCrtFile": "",
    "tlsKeyFile": "",
    "tlsServerName": ""
  },
  "monitor": {
    "address": "",
    "alarmPath": "/mep/v1/modelmonitor/alarm",
    "serviceName": "aigw_service",
    "version" : "1.0.0",
    "businessId" : ""
  },
  "dataSync": {
    "address": "",
    "path": "/getAIGWEnableModelList",
    "interval": 5
  },
  "predictor": {
    "predictType": "none",
    "lightgbm": {
      "classifierFile": "",
      "vectorizerFile": ""
    }
  },
  "tokenizers": [
    {
      "tokenizeModelName": "DeepSeek-R1",
      "configPath": "/etc/aigw/at/tokenizer/DeepSeek-R1-Distill-Qwen-7B/tokenizer.json",
      "tokenizerType": "huggingfaceTokenizers"
    }
  ],
  "globalSchedulers": [
    {
      "model": "DeepSeek-R1-Distill-Qwen-7B",
      "blockSize": 128,
      "deployPolicy": "mixed",
      "maxTimeToFirstToken": 200,
      "maxTimeBetweenTokens": 50,
      "tokenizeModelName": "DeepSeek-R1",

      "loadBalancer": {
        "mixed": "capacity",
        "prefill": "",
        "decode": "",
        "batchSize": 32,
        "enablePowerOfTwo": false,
        "reservedBlockNumber": 50,
        "minMatchedLength": 200,
        "pretrainTTFTPath": ""
      },
      "instanceConnectType": "sse"
    }
  ],
  "limits": {
    "totalInsNum": 2048,
    "insNumPerModel": 128,
    "modelNum": 128,
    "concurrency": 128,
    "maxPromptRunes": 131072
  }
}
