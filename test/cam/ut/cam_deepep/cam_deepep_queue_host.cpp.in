    Dim3(uint32_t x, uint32_t, uint32_t) : x(x) {}
};
template <auto Function, class... Args> void VF_CALL(Dim3 dim, Args... args)
{
    for (threadIdx.x = 0; threadIdx.x < dim.x; ++threadIdx.x) {
        Function(args...);
    }
}
