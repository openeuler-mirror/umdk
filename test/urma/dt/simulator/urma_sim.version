URMA_SIM_UMMU {
    global:
        ummu_allocate_tid;
        ummu_grant;
        ummu_ungrant;
        ummu_ungrant_by_token;
        ummu_free_tid;
};

URMA_SIM_API {
    global:
        urma_sim_ipc_start;
        urma_sim_ipc_is_local;
        urma_sim_ipc_read;
        urma_sim_ipc_write;
        urma_sim_hw_start;
};

GLIBC_2.17 {
    global:
        open;
        __open_2;
        close;
        opendir;
        read;
        ioctl;
        access;
        mmap;
        munmap;
        realpath;
};

GLIBC_2.33 {
    global:
        stat;
} GLIBC_2.17;
